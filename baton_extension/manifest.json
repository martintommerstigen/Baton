{
  "manifest_version": 3,
  "name": "Baton · Greg",
  "version": "0.2.0",
  "description": "Connect a selected existing ChatGPT conversation to your own local Baton Core on Greg. No GitHub runtime transport.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
